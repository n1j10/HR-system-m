generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  HR_STAFF
  MANAGER
  EMPLOYEE
  RECRUITER
  FINANCE
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  REMOTE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum JobStatus {
  OPEN
  CLOSED
}

enum CandidateStage {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum AssetCondition {
  GOOD
  MAINTENANCE
  DAMAGED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─────────────────────────── Auth & Users ────────────────────────────

// One row per Clerk account. Created automatically on the first sign-in.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee      Employee?
  auditLogs     AuditLog[]
  announcements Announcement[]
  reviewsGiven  PerformanceReview[]
}

// ─────────────────────────── Organization ────────────────────────────

model Department {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]
}

model Position {
  id          String     @id @default(cuid())
  title       String     @unique
  level       Int?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]
}

// ───────────────────────────── Employees ─────────────────────────────

model Employee {
  id                    String         @id @default(cuid())
  employeeNumber        String         @unique
  firstName             String
  lastName              String
  email                 String         @unique
  phone                 String?
  gender                Gender?
  birthDate             DateTime?      @db.Date
  nationality           String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  positionId   String
  position     Position   @relation(fields: [positionId], references: [id])
  managerId    String?
  manager      Employee?  @relation("ManagerToReports", fields: [managerId], references: [id])
  reports      Employee[] @relation("ManagerToReports")

  hireDate         DateTime       @db.Date
  probationEndDate DateTime?      @db.Date
  contractType     ContractType   @default(FULL_TIME)
  status           EmployeeStatus @default(ACTIVE)

  baseSalary  Decimal @db.Decimal(12, 2)
  allowances  Decimal @default(0) @db.Decimal(12, 2)
  currency    String  @default("IQD")
  bankName    String?
  bankAccount String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
  payslips       Payslip[]
  documents      Document[]
  assets         Asset[]
  goals          Goal[]
  reviews        PerformanceReview[]

  @@index([departmentId])
  @@index([status])
}

// ──────────────────────────── Attendance ─────────────────────────────

model Attendance {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  date            DateTime         @db.Date
  checkInAt       DateTime?
  checkOutAt      DateTime?
  lateMinutes     Int              @default(0)
  overtimeMinutes Int              @default(0)
  status          AttendanceStatus @default(PRESENT)
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @unique @db.Date
  createdAt DateTime @default(now())
}

// ────────────────────────────── Leaves ───────────────────────────────

model LeaveType {
  id                 String         @id @default(cuid())
  name               String         @unique
  daysPerYear        Int
  isPaid             Boolean        @default(true)
  requiresAttachment Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  balances           LeaveBalance[]
  requests           LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Int
  usedDays    Int       @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  leaveTypeId   String
  leaveType     LeaveType     @relation(fields: [leaveTypeId], references: [id])
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  days          Int
  reason        String?
  attachmentUrl String?
  status        RequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId, status])
}

// ────────────────────────────── Payroll ──────────────────────────────

model PayrollRun {
  id        String        @id @default(cuid())
  month     Int
  year      Int
  status    PayrollStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  payslips  Payslip[]

  @@unique([month, year])
}

model Payslip {
  id               String     @id @default(cuid())
  payrollRunId     String
  payrollRun       PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id])
  baseSalary       Decimal    @db.Decimal(12, 2)
  allowances       Decimal    @db.Decimal(12, 2)
  bonus            Decimal    @default(0) @db.Decimal(12, 2)
  absentDays       Int        @default(0)
  unpaidLeaveDays  Int        @default(0)
  absenceDeduction Decimal    @default(0) @db.Decimal(12, 2)
  otherDeductions  Decimal    @default(0) @db.Decimal(12, 2)
  netSalary        Decimal    @db.Decimal(12, 2)
  currency         String     @default("IQD")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([payrollRunId, employeeId])
}

// ──────────────────────────── Recruitment ────────────────────────────

model JobPosting {
  id          String      @id @default(cuid())
  title       String
  description String
  location    String?
  status      JobStatus   @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  candidates  Candidate[]
}

model Candidate {
  id           String         @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String?
  resumeUrl    String?
  coverLetter  String?
  stage        CandidateStage @default(NEW)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─────────────────────── Documents & Assets ──────────────────────────

model Document {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  title      String
  category   String
  fileUrl    String
  expiresAt  DateTime? @db.Date
  createdAt  DateTime  @default(now())
}

model Asset {
  id                 String         @id @default(cuid())
  name               String
  category           String
  serialNumber       String?        @unique
  condition          AssetCondition @default(GOOD)
  assignedEmployeeId String?
  assignedEmployee   Employee?      @relation(fields: [assignedEmployeeId], references: [id])
  assignedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

// ──────────────────────────── Performance ────────────────────────────

model Goal {
  id          String     @id @default(cuid())
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id])
  title       String
  description String?
  dueDate     DateTime?  @db.Date
  progress    Int        @default(0)
  status      GoalStatus @default(NOT_STARTED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model PerformanceReview {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  period     String
  rating     Int
  comments   String?
  createdAt  DateTime @default(now())
}

// ─────────────────────── Announcements & Audit ───────────────────────

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Append-only: the app never updates or deletes rows in this table.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
