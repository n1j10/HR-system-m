# Copy to .env and fill in real values. Never commit real secrets.

# PostgreSQL connection string (local, Neon or Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# Clerk keys: https://dashboard.clerk.com -> API Keys
# (In development you can leave them empty: Clerk runs in "keyless" mode.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Used by the seed script: an employee record is created with this email,
# so your first sign-in is linked to it automatically.
ADMIN_EMAIL=
